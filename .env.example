# Never commit real values. Copy this file to .env.local and fill it in there.

# Signs session cookies. Use a long random string (32+ characters).
SESSION_SECRET=replace-with-a-long-random-string

# Optional: where the SQLite database lives (default: data/harness.db).
HARNESS_DB_PATH=

# Sending is OFF unless this is exactly 1 AND a principal approval exists for the content hash.
OUTBOUND_SEND_ENABLED=0
# Outbound provider: unset = dry run. "apollo" or "instantly" only when you are ready.
OUTBOUND_PROVIDER=

# Apollo (optional). Leave blank to keep Apollo off.
APOLLO_API_KEY=
APOLLO_SEQUENCE_ID=
APOLLO_EMAIL_ACCOUNT_ID=

# Instantly (optional). Leave blank to keep Instantly off.
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
# Comma list of YOUR OWN sending domains, e.g. send.yourfirm.example
INSTANTLY_ALLOWED_DOMAINS=

# Public base URL used in unsubscribe links, e.g. https://dealdesk.yourfirm.example
APP_BASE_URL=
